    <Compile Include="Storage/SQLiteStore.fs" />
    <Compile Include="AppliedOperation.fs" />
    <Compile Include="Runtime/Session.fs" />
    <Compile Include="Runtime/Workspace.fs" />
    <Compile Include="Operations/DatasetOperations.fs" />
    <Compile Include="Operations/ProcessOperations.fs" />
    <Compile Include="Operations/SampleOperations.fs" />
    <Compile Include="Operations/OrganizationOperations.fs" />
    <Compile Include="Operations/AgentOperations.fs" />
    <Compile Include="Operations/ScholarlyArticleOperations.fs" />
    <Compile Include="Operations/AnnotationOperations.fs" />
    <Compile Include="Operations/FormalParameterOperations.fs" />
    <Compile Include="Operations/DefinedTermSetOperations.fs" />
    <Compile Include="Operations/DefinedTermOperations.fs" />
